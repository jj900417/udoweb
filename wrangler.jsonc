{
  // Cloudflare Workers 배포 설정 — udonow.co.kr (도메인은 Cloudflare 에 연결됨).
  // Worker 가 dist/ 를 SPA 폴백으로 서빙하고, /api/udo/* · /media/* 는
  // 우도 나우 앱 서버로 프록시한다(worker/index.ts).
  //
  // 배포:  npm run build && npx wrangler deploy
  // (첫 배포 전 `npx wrangler login` 필요. 배포는 사람이 실행한다.)
  "name": "udoweb",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "routes": [
    { "pattern": "udonow.co.kr", "custom_domain": true },
    { "pattern": "www.udonow.co.kr", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 모든 요청이 Worker 를 먼저 지나게 한다.
    // ["/api/*","/media/*"] 로 좁혀 두면 정적 자산(HTML 포함)이 Worker 를 건너뛰어
    // http→https 리다이렉트와 보안 헤더가 적용되지 않는다(실제로 그랬다).
    "run_worker_first": true
  }
}
